{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "trustedProxies": [
      "127.0.0.1",
      "::1",
      "100.64.0.0/10"
    ],
    "auth": {
      "mode": "token",
      "token": "{{ gateway_token }}"
    },
    "controlUi": {
      "dangerouslyDisableDeviceAuth": false,
      "allowedOrigins": [
        "https://{{ target_hostname }}.ts.net",
        "http://localhost:18789",
        "http://127.0.0.1:18789",
        "https://localhost:18789",
        "https://127.0.0.1:18789"{% if tailscale_self_hostname | default('') | length > 0 %},
        "https://{{ tailscale_self_hostname }}"{% endif %}
      ]
    }
  },
  "discovery": {
    "mdns": { "mode": "off" }
  },
  "logging": {
    "level": "info",
    "consoleLevel": "info",
    "consoleStyle": "compact",
    "redactSensitive": "tools"
  },
{% if openrouter_key | default('') | length > 0 or mistral_key | default('') | length > 0 or llm_provider == 'minimax' %}
  "env": {
{% if llm_provider == 'minimax' %}
    "MINIMAX_API_KEY": "{{ llm_key }}"{% if openrouter_key | default('') | length > 0 or mistral_key | default('') | length > 0 %},{% endif %}

{% endif %}
{% if openrouter_key | default('') | length > 0 %}
    "OPENROUTER_API_KEY": "{{ openrouter_key }}"{% if mistral_key | default('') | length > 0 %},{% endif %}

{% endif %}
{% if mistral_key | default('') | length > 0 %}
    "MISTRAL_API_KEY": "{{ mistral_key }}"
{% endif %}
  },
{% endif %}
  "models": {
    "mode": "merge",
    "providers": {
{% if llm_provider == 'anthropic' %}
      "anthropic": {
        "apiKey": "{{ llm_key }}",
        "api": "anthropic-messages",
        "baseUrl": "https://api.anthropic.com",
        "models": [
          {
            "id": "{{ llm_model }}",
            "name": "{{ llm_model }}",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8096
          }{% if stoic_telegram_bottoken | default('') | length > 0 and llm_model != 'claude-sonnet-4-6' %},
          {
            "id": "claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8096
          }{% endif %}
        ]
      }
{% elif llm_provider == 'openai' %}
      "openai": {
        "apiKey": "{{ llm_key }}",
        "api": "openai-completions",
        "baseUrl": "https://api.openai.com/v1",
        "models": [
          {
            "id": "{{ llm_model }}",
            "name": "{{ llm_model }}",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      }{% if anthropic_api_key | default('') | length > 0 %},
      "anthropic": {
        "apiKey": "{{ anthropic_api_key }}",
        "api": "anthropic-messages",
        "baseUrl": "https://api.anthropic.com",
        "models": [
          {
            "id": "claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8096
          }
        ]
      }{% endif %}
{% elif llm_provider == 'minimax' %}
      "minimax": {
        "api": "anthropic-messages",
        "baseUrl": "https://api.minimax.io/anthropic",
        "apiKey": "${MINIMAX_API_KEY}",
        "models": [
          {
            "id": "{{ llm_model }}",
            "name": "{{ llm_model }}",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 200000,
            "maxTokens": 8192,
            "cost": {
              "input": 0.3,
              "output": 1.2,
              "cacheRead": 0.03,
              "cacheWrite": 0.375
            }
          },
          {
            "id": "MiniMax-M2.1",
            "name": "MiniMax M2.1",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 200000,
            "maxTokens": 8192,
            "cost": {
              "input": 0.3,
              "output": 1.2,
              "cacheRead": 0.03,
              "cacheWrite": 0.375
            }
          },
          {
            "id": "M2-her",
            "name": "M2-her",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 65536,
            "maxTokens": 2048,
            "cost": { "input": 0.0, "output": 0.0 }
          }
        ]
      }{% if anthropic_api_key | default('') | length > 0 %},
      "anthropic": {
        "apiKey": "{{ anthropic_api_key }}",
        "api": "anthropic-messages",
        "baseUrl": "https://api.anthropic.com",
        "models": [
          {
            "id": "claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8096
          }
        ]
        }{% endif %}{% if mistral_key | default('') | length > 0 %},
        "mistral": {
        "apiKey": "{{ mistral_key }}",
        "api": "openai-completions",
        "baseUrl": "https://api.mistral.ai/v1",
        "models": [
          {
            "id": "mistral-medium-2508",
            "name": "Mistral Medium 2508",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 32768,
            "maxTokens": 4096
          }
        ]
      }{% endif %}
{% elif llm_provider == 'openai_compatible' %}
      "openai": {
        "apiKey": "{{ llm_key }}",
        "api": "openai-completions",
        "baseUrl": "{{ llm_url }}",
        "models": [
          {
            "id": "{{ llm_model }}",
            "name": "{{ llm_model }}",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      }{% if anthropic_api_key | default('') | length > 0 %},
      "anthropic": {
        "apiKey": "{{ anthropic_api_key }}",
        "api": "anthropic-messages",
        "baseUrl": "https://api.anthropic.com",
        "models": [
          {
            "id": "claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8096
          }
        ]
      }{% endif %}
{% elif llm_provider == 'ollama' %}
      "ollama": {
        "baseUrl": "{{ llm_url }}"
      }{% if anthropic_api_key | default('') | length > 0 %},
      "anthropic": {
        "apiKey": "{{ anthropic_api_key }}",
        "api": "anthropic-messages",
        "baseUrl": "https://api.anthropic.com",
        "models": [
          {
            "id": "claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8096
          }
        ]
      }{% endif %}
{% endif %}
    }
  },
  "channels": {
{% if telegram_bottoken | default('') | length > 0 and telegram_userid | default('') | length > 0 %}
    "telegram": {
      "enabled": true,
      "commands": { "native": true, "nativeSkills": true },
      "configWrites": false,
      "dmPolicy": "pairing",
      "allowFrom": [ {{ telegram_userid }} ],
      "groupPolicy": "allowlist",
      "dms": { "{{ telegram_userid }}": {} },
      "streamMode": "partial",
      "actions": { "reactions": true, "sendMessage": true },
      "heartbeat": { "showOk": true, "showAlerts": true, "useIndicator": true },
      "accounts": {
        "default": {
          "name": "RightClamp",
          "botToken": "{{ telegram_bottoken }}"
        }{% if rp_telegram_bottoken | default('') | length > 0 %},
        "sirshellspeare": {
          "name": "SirShellspeare",
          "botToken": "{{ rp_telegram_bottoken }}"
        }{% endif %}{% if moltbook_telegram_bottoken | default('') | length > 0 %},
        "sociaclamps": {
          "name": "Sociaclamps",
          "botToken": "{{ moltbook_telegram_bottoken }}"
        }{% endif %}{% if stoic_telegram_bottoken | default('') | length > 0 %},
        "seneclaw": {
          "name": "Seneclaw",
          "botToken": "{{ stoic_telegram_bottoken }}"
        }{% endif %}
      }
    }
{% else %}
    "telegram": { "dmPolicy": "pairing" }
{% endif %}
  },
{% if telegram_bottoken | default('') | length > 0 and (rp_telegram_bottoken | default('') | length > 0 or moltbook_telegram_bottoken | default('') | length > 0 or stoic_telegram_bottoken | default('') | length > 0) %}
  "bindings": [
    { "agentId": "main", "match": { "channel": "telegram", "accountId": "default" } }{% if rp_telegram_bottoken | default('') | length > 0 %},
    { "agentId": "sirshellspeare", "match": { "channel": "telegram", "accountId": "sirshellspeare" } }{% endif %}{% if moltbook_telegram_bottoken | default('') | length > 0 %},
    { "agentId": "sociaclamps", "match": { "channel": "telegram", "accountId": "sociaclamps" } }{% endif %}{% if stoic_telegram_bottoken | default('') | length > 0 %},
    { "agentId": "seneclaw", "match": { "channel": "telegram", "accountId": "seneclaw" } }{% endif %}
  ],
{% endif %}
  "agents": {
    "defaults": {
      "model": {
        "primary": "{{ 'openai' if llm_provider == 'openai_compatible' else llm_provider }}/{{ llm_model }}",
        "fallbacks": [
{% if llm_provider == 'minimax' %}
          "minimax/MiniMax-M2.1"
{% endif %}
        ]
      },
{% if llm_provider == 'minimax' %}
      "models": {
        "minimax/{{ llm_model }}": { "alias": "Minimax" }
      },
{% endif %}
      "heartbeat": { "every": "5m" },
      "contextTokens": 80000,
      "compaction": {
        "mode": "safeguard",
        "reserveTokensFloor": 24000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 6000
        }
      }{% if gemini_key | default('') | length > 0 %},
      "memorySearch": {
        "provider": "gemini",
        "model": "gemini-embedding-001",
        "remote": {
          "apiKey": "{{ gemini_key }}"
        }
      }
{% endif %}
    },
    "list": [
      {
        "id": "main",
        "name": "RightClamp",
        "workspace": "{{ openclaw_home }}/workspace",
        "default": true,
        "model": {
          "primary": "{{ 'openai' if llm_provider == 'openai_compatible' else llm_provider }}/{{ llm_model }}",
          "fallbacks": [
{% if llm_provider == 'minimax' %}
            "minimax/MiniMax-M2.1"
{% endif %}
          ]
        }
      }{% if llm_provider == 'minimax' %},
      {
        "id": "pincermove",
        "name": "ThePincerMove",
        "workspace": "{{ openclaw_home }}/workspace-pincermove",
        "model": {
{% if mistral_key | default('') | length > 0 %}
          "primary": "mistral/mistral-medium-2508",
          "fallbacks": []
{% else %}
          "primary": "openrouter/stepfun/step-3.5-flash:free",
          "fallbacks": ["minimax/MiniMax-M2.1"]
{% endif %}
        },
        "tools": {
          "deny": ["write", "edit", "apply_patch", "browser", "process"]
        }
      }{% if rp_telegram_bottoken | default('') | length > 0 %},
      {
        "id": "sirshellspeare",
        "name": "SirShellspeare",
        "workspace": "{{ openclaw_home }}/workspace-rp",
        "model": {
          "primary": "minimax/{{ llm_model }}",
          "fallbacks": []
        },
        "tools": {
          "deny": ["browser", "process"]
        }
      }{% endif %}{% endif %}{% if moltbook_telegram_bottoken | default('') | length > 0 %},
      {
        "id": "sociaclamps",
        "name": "Sociaclamps",
        "workspace": "{{ openclaw_home }}/workspace-sociaclamps",
        "model": {
{% if anthropic_api_key | default('') | length > 0 %}
          "primary": "anthropic/claude-sonnet-4-6",
{% else %}
          "primary": "{{ 'openai' if llm_provider == 'openai_compatible' else llm_provider }}/{{ llm_model }}",
{% endif %}
          "fallbacks": []
        },
        "tools": {
          "deny": ["edit", "apply_patch", "browser", "process", "gateway", "canvas"]
        }
      }{% endif %}{% if stoic_telegram_bottoken | default('') | length > 0 %},
      {
        "id": "seneclaw",
        "name": "Seneclaw",
        "workspace": "{{ openclaw_home }}/workspace-seneclaw",
        "model": {
{% if anthropic_api_key | default('') | length > 0 or llm_provider == 'anthropic' %}
          "primary": "anthropic/claude-sonnet-4-6",
{% else %}
          "primary": "{{ 'openai' if llm_provider == 'openai_compatible' else llm_provider }}/{{ llm_model }}",
{% endif %}
          "fallbacks": []
        },
        "tools": {
          "deny": ["browser", "process", "edit", "apply_patch", "gateway", "canvas"]
        }
      }{% endif %}
    ]
  },
  "tools": {
    "exec": {
      "strictInlineEval": true
    },
    "loopDetection": {
      "enabled": true,
      "historySize": 30,
      "warningThreshold": 10,
      "criticalThreshold": 20,
      "globalCircuitBreakerThreshold": 30,
      "detectors": {
        "genericRepeat": true,
        "knownPollNoProgress": true,
        "pingPong": true
      }
    }{% if brave_key | default('') | length > 0 %},
    "web": {
      "search": {
        "provider": "brave",
        "apiKey": "{{ brave_key }}"
      },
      "fetch": {
        "enabled": true
      }
    }
{% endif %}
  }
}
