{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "trustedProxies": [
      "127.0.0.1",
      "::1",
      "100.64.0.0/10"
    ],
    "auth": {
      "mode": "token",
      "token": "{{ gateway_token }}"
    },
    "controlUi": {
      "dangerouslyDisableDeviceAuth": false,
      "allowedOrigins": [
        "https://{{ target_hostname }}.ts.net",
        "http://localhost:18789",
        "http://127.0.0.1:18789",
        "https://localhost:18789",
        "https://127.0.0.1:18789"{% if tailscale_self_hostname | default('') | length > 0 %},
        "https://{{ tailscale_self_hostname }}"{% endif %}
      ]
    }
  },
  "discovery": {
    "mdns": { "mode": "off" }
  },
  "logging": {
    "level": "info",
    "consoleLevel": "info",
    "consoleStyle": "compact",
    "redactSensitive": "tools"
  },
  "models": {
    "mode": "merge",
    "providers": {
{% if llm_provider == 'anthropic' %}
      "anthropic": {
        "apiKey": "{{ llm_key }}",
        "api": "anthropic-messages",
        "baseUrl": "https://api.anthropic.com",
        "models": [
          {
            "id": "{{ llm_model }}",
            "name": "{{ llm_model }}",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8096
          }
        ]
      }
{% elif llm_provider == 'openai' %}
      "openai": {
        "apiKey": "{{ llm_key }}",
        "api": "openai-completions",
        "baseUrl": "https://api.openai.com/v1",
        "models": [
          {
            "id": "{{ llm_model }}",
            "name": "{{ llm_model }}",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      }
{% elif llm_provider == 'minimax' %}
      "minimax": {
        "api": "anthropic-messages",
        "baseUrl": "https://api.minimax.io/anthropic",
        "apiKey": "${MINIMAX_API_KEY}",
        "models": [
          {
            "id": "{{ llm_model }}",
            "name": "{{ llm_model }}",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
{% elif llm_provider == 'openai_compatible' %}
      "openai": {
        "apiKey": "{{ llm_key }}",
        "api": "openai-completions",
        "baseUrl": "{{ llm_url }}",
        "models": [
          {
            "id": "{{ llm_model }}",
            "name": "{{ llm_model }}",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      }
{% elif llm_provider == 'ollama' %}
      "ollama": {
        "baseUrl": "{{ llm_url }}"
      }
{% endif %}
    }
  },
  "channels": {
{% if telegram_bottoken | default('') | length > 0 and telegram_userid | default('') | length > 0 %}
    "telegram": {
      "enabled": true,
      "commands": { "native": true, "nativeSkills": true },
      "configWrites": false,
      "dmPolicy": "pairing",
      "allowFrom": [ {{ telegram_userid }} ],
      "groupPolicy": "allowlist",
      "dms": { "{{ telegram_userid }}": {} },
      "streaming": "partial",
      "actions": { "reactions": true, "sendMessage": true },
      "heartbeat": { "showOk": true, "showAlerts": true, "useIndicator": true },
      "accounts": {
        "default": {
          "name": "OpenClaw",
          "botToken": "{{ telegram_bottoken }}"
        }
      }
    }
{% else %}
    "telegram": { "dmPolicy": "pairing" }
{% endif %}
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "{{ 'openai' if llm_provider == 'openai_compatible' else llm_provider }}/{{ llm_model }}",
        "fallbacks": []
      },
      "heartbeat": { "every": "5m" },
      "contextTokens": 80000,
      "timeoutSeconds": 240,
      "compaction": {
        "mode": "safeguard",
        "reserveTokensFloor": 24000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 6000
        }
      }{% if gemini_key | default('') | length > 0 %},
      "memorySearch": {
        "provider": "gemini",
        "model": "gemini-embedding-001",
        "remote": {
          "apiKey": "{{ gemini_key }}"
        }
      }
{% endif %}
    },
    "list": [
      {
        "id": "main",
        "name": "Main",
        "workspace": "{{ openclaw_home }}/workspace",
        "default": true,
        "model": {
          "primary": "{{ 'openai' if llm_provider == 'openai_compatible' else llm_provider }}/{{ llm_model }}",
          "fallbacks": []
        }
      }
    ]
  },
  "tools": {
    "exec": {
      "strictInlineEval": true
    },
    "loopDetection": {
      "enabled": true,
      "historySize": 30,
      "warningThreshold": 10,
      "criticalThreshold": 20,
      "globalCircuitBreakerThreshold": 30,
      "detectors": {
        "genericRepeat": true,
        "knownPollNoProgress": true,
        "pingPong": true
      }
    }{% if brave_key | default('') | length > 0 %},
    "web": {
      "search": {
        "provider": "brave"
      },
      "fetch": {
        "enabled": true
      }
    },
    "plugins": {
      "entries": {
        "brave": {
          "config": {
            "webSearch": {
              "apiKey": "{{ brave_key }}"
            }
          }
        }
      }
    }
{% endif %}
  }
}
