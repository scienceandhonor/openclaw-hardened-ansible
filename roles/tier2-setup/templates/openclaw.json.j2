{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "trustedProxies": [
      "127.0.0.1",
      "::1",
      "100.64.0.0/10"
    ],
    "auth": {
      "mode": "token",
      "token": "{{ gateway_token }}"
    },
    "controlUi": {
      "dangerouslyDisableDeviceAuth": false,
      "allowedOrigins": [
        "https://{{ target_hostname }}.ts.net",
        "http://localhost:18789",
        "http://127.0.0.1:18789",
        "https://localhost:18789",
        "https://127.0.0.1:18789"
      ]
    }
  },
  "discovery": {
    "mdns": { "mode": "off" }
  },
  "models": {
    "mode": "merge",
    "providers": {
{% if llm_provider == 'anthropic' %}
      "anthropic": {
        "apiKey": "{{ llm_key }}",
        "api": "anthropic-messages",
        "baseUrl": "https://api.anthropic.com",
        "models": [
          {
            "id": "{{ llm_model }}",
            "name": "{{ llm_model }}",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 8096
          }
        ]
      }
{% elif llm_provider == 'openai' %}
      "openai": {
        "apiKey": "{{ llm_key }}",
        "api": "openai-completions",
        "baseUrl": "https://api.openai.com/v1",
        "models": [
          {
            "id": "{{ llm_model }}",
            "name": "{{ llm_model }}",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      }
{% elif llm_provider == 'openai_compatible' %}
      "openai": {
        "apiKey": "{{ llm_key }}",
        "api": "openai-completions",
        "baseUrl": "{{ llm_url }}",
        "models": [
          {
            "id": "{{ llm_model }}",
            "name": "{{ llm_model }}",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 4096
          }
          ,{
            "id": "MiniMax-M2.1",
            "name": "MiniMax M2.1",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
{% elif llm_provider == 'ollama' %}
      "ollama": {
        "baseUrl": "{{ llm_url }}"
      }
{% endif %}
    }
  },
  "channels": {
{% if telegram_bottoken | default('') | length > 0 and telegram_userid | default('') | length > 0 %}
    "telegram": {
      "enabled": true,
      "commands": { "native": true, "nativeSkills": true },
      "configWrites": false,
      "dmPolicy": "pairing",
      "allowFrom": [ {{ telegram_userid }} ],
      "groupPolicy": "allowlist",
      "dms": { "{{ telegram_userid }}": {} },
      "streamMode": "partial",
      "actions": { "reactions": true, "sendMessage": true },
      "heartbeat": { "showOk": true, "showAlerts": true, "useIndicator": true },
      "accounts": {
        "default": {
          "name": "RightClamp",
          "botToken": "{{ telegram_bottoken }}"
        }
      }
    }
{% else %}
    "telegram": { "dmPolicy": "pairing" }
{% endif %}
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "{{ 'openai' if llm_provider == 'openai_compatible' else llm_provider }}/{{ llm_model }}",
        "fallbacks": [
{% if llm_provider == 'openai_compatible' %}
          "openai/MiniMax-M2.1"
{% endif %}
        ]
      },
      "heartbeat": { "every": "5m" }
    },
    "list": [
      {
        "id": "main",
        "name": "RightClamp",
        "workspace": "{{ openclaw_home }}/workspace",
        "agentDir": "{{ openclaw_home }}/.openclaw/agents/main",
        "default": true,
        "model": {
          "primary": "{{ 'openai' if llm_provider == 'openai_compatible' else llm_provider }}/{{ llm_model }}",
          "fallbacks": [
{% if llm_provider == 'openai_compatible' %}
            "openai/MiniMax-M2.1"
{% endif %}
          ]
        }
      }
    ]
  }{% if brave_key | default('') | length > 0 %},
  "tools": {
    "web": {
      "search": {
        "provider": "brave",
        "apiKey": "{{ brave_key }}"
      },
      "fetch": {
        "enabled": true
      }
    }
  }
{% endif %}
}
