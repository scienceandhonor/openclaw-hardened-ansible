#!/usr/bin/env python3
"""
check-substack-email.py — IMAP poller for Substack newsletters.

Reads credentials from environment (set via scripts-config.env).
Outputs a JSON array of new Substack emails to stdout; exits 0 on error
with an empty array so the calling cron job degrades gracefully.
"""

import email
import email.header
import html.parser
import imaplib
import json
import os
import re
import sys

# ── Config ────────────────────────────────────────────────────────────────────

IMAP_HOST   = os.environ.get('IMAP_HOST', '')
IMAP_USER   = os.environ.get('IMAP_USER', '')
IMAP_PASS   = os.environ.get('IMAP_PASSWORD', '')
IMAP_FOLDER = os.environ.get('IMAP_FOLDER', 'INBOX')

OPENCLAW_HOME = os.environ.get('OPENCLAW_HOME',
                               os.path.join(os.environ['HOME'], '.openclaw'))
STATE_DIR  = os.path.join(OPENCLAW_HOME, 'email-state')
STATE_FILE = os.path.join(STATE_DIR, 'processed.json')

MAX_PER_RUN   = 10    # cost guard: max emails processed per run
PREVIEW_CHARS = 3000  # max body chars passed to the agent
STATE_MAX_IDS = 2000  # cap on stored message-IDs to prevent unbounded growth
SCAN_WINDOW   = 200   # look back at most this many messages in the folder

# ── Helpers ───────────────────────────────────────────────────────────────────

def decode_header_value(val):
    """Decode a MIME encoded-word header value to a plain string."""
    parts = email.header.decode_header(val or '')
    decoded = []
    for part, charset in parts:
        if isinstance(part, bytes):
            decoded.append(part.decode(charset or 'utf-8', errors='replace'))
        else:
            decoded.append(part)
    return ''.join(decoded)


class _HTMLStripper(html.parser.HTMLParser):
    def __init__(self):
        super().__init__()
        self._parts = []

    def handle_data(self, data):
        self._parts.append(data)

    def get_text(self):
        return ' '.join(self._parts)


def strip_html(content):
    s = _HTMLStripper()
    try:
        s.feed(content)
    except Exception:
        pass
    return re.sub(r'\s+', ' ', s.get_text()).strip()


def extract_preview(msg):
    """Return plain-text preview: prefer text/plain, fall back to stripped HTML."""
    plain = None
    html_body = None

    if msg.is_multipart():
        for part in msg.walk():
            ct = part.get_content_type()
            raw = part.get_payload(decode=True)
            if not raw:
                continue
            charset = part.get_content_charset() or 'utf-8'
            text = raw.decode(charset, errors='replace')
            if ct == 'text/plain' and plain is None:
                plain = text
            elif ct == 'text/html' and html_body is None:
                html_body = text
    else:
        raw = msg.get_payload(decode=True)
        if raw:
            charset = msg.get_content_charset() or 'utf-8'
            text = raw.decode(charset, errors='replace')
            if msg.get_content_type() == 'text/plain':
                plain = text
            else:
                html_body = text

    body = plain if plain else (strip_html(html_body) if html_body else '')

    # Trim common Substack footer markers so the preview stays on-topic
    for marker in ('Unsubscribe', 'unsubscribe', 'You are receiving this',
                   'View in browser', 'Update your email preferences'):
        idx = body.rfind(marker)
        if 0 < idx and idx > PREVIEW_CHARS // 2:
            body = body[:idx]
            break

    return body[:PREVIEW_CHARS].strip()


def is_substack(msg):
    """Return True if this email originated from Substack infrastructure."""
    # Most robust: List-Unsubscribe URL contains substack.com
    if 'substack.com' in (msg.get('List-Unsubscribe') or '').lower():
        return True
    # Sender header (envelope sender set by Substack's mailer)
    if 'substack.com' in (msg.get('Sender') or '').lower():
        return True
    # From address — weakest signal, kept as last resort
    if 'substack.com' in (msg.get('From') or '').lower():
        return True
    return False

# ── State ─────────────────────────────────────────────────────────────────────

def load_state():
    os.makedirs(STATE_DIR, exist_ok=True)
    try:
        with open(STATE_FILE) as f:
            data = json.load(f)
        if isinstance(data, list):
            return set(data)
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    return set()


def save_state(seen_ids):
    os.makedirs(STATE_DIR, exist_ok=True)
    ids_list = list(seen_ids)
    if len(ids_list) > STATE_MAX_IDS:
        ids_list = ids_list[-STATE_MAX_IDS:]
    tmp = STATE_FILE + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(ids_list, f)
    os.replace(tmp, STATE_FILE)

# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    if not IMAP_HOST or not IMAP_USER or not IMAP_PASS:
        print('[]')
        print('check-substack-email: IMAP credentials not configured.',
              file=sys.stderr)
        return

    seen_ids = load_state()
    results  = []

    try:
        conn = imaplib.IMAP4_SSL(IMAP_HOST, 993)
        conn.login(IMAP_USER, IMAP_PASS)
        conn.select(IMAP_FOLDER, readonly=False)

        status, data = conn.search(None, 'ALL')
        if status != 'OK':
            raise RuntimeError(f'IMAP search failed: {status}')

        all_uids = data[0].split()
        # Scan only the most recent SCAN_WINDOW messages to bound latency
        candidates = all_uids[-SCAN_WINDOW:]

        # First pass: fetch headers only to find new Substack messages cheaply
        new_messages = []
        for uid in candidates:
            status, hdr_data = conn.fetch(
                uid,
                '(BODY.PEEK[HEADER.FIELDS (MESSAGE-ID LIST-UNSUBSCRIBE SENDER FROM)])'
            )
            if status != 'OK' or not hdr_data or hdr_data[0] is None:
                continue
            hdr_bytes = hdr_data[0][1] if isinstance(hdr_data[0], tuple) else b''
            hdr = email.message_from_bytes(hdr_bytes)

            msg_id = (hdr.get('Message-ID') or '').strip()
            if not msg_id or msg_id in seen_ids:
                continue
            if not is_substack(hdr):
                continue
            new_messages.append((uid, msg_id))

        # Cost guard: process oldest MAX_PER_RUN, defer the rest
        skipped = max(0, len(new_messages) - MAX_PER_RUN)
        if skipped:
            print(f'check-substack-email: {skipped} additional new emails '
                  f'deferred to next run.', file=sys.stderr)
        new_messages = new_messages[:MAX_PER_RUN]

        # Second pass: fetch full messages for the selected candidates
        new_seen = set()
        for uid, msg_id in new_messages:
            status, msg_data = conn.fetch(uid, '(RFC822)')
            if status != 'OK' or not msg_data or msg_data[0] is None:
                continue
            raw = msg_data[0][1] if isinstance(msg_data[0], tuple) else b''
            msg = email.message_from_bytes(raw)

            subject    = decode_header_value(msg.get('Subject', '(no subject)'))
            from_raw   = decode_header_value(msg.get('From', ''))
            date_str   = msg.get('Date', '')
            preview    = extract_preview(msg)
            # Newsletter display name: text before the angle-bracketed address
            newsletter = from_raw.split('<')[0].strip().strip('"\'') or from_raw

            results.append({
                'subject':    subject,
                'from_name':  from_raw,
                'newsletter': newsletter,
                'date':       date_str,
                'preview':    preview,
                'message_id': msg_id,
            })
            conn.store(uid, '+FLAGS', '\\Seen')
            new_seen.add(msg_id)

        conn.logout()

        if new_seen:
            seen_ids.update(new_seen)
            save_state(seen_ids)

    except Exception as exc:
        print('[]')
        print(f'check-substack-email: error: {exc}', file=sys.stderr)
        return

    print(json.dumps(results, ensure_ascii=False))


if __name__ == '__main__':
    main()
