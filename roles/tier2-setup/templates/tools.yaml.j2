# Generated by Ansible (Hardened Tier 2)
tools:
  shell:
    enabled: true
    allowlist:
      - "bash"
      - "ls"
      - "cat"
      - "grep"
      - "head"
      - "tail"
      - "find"
      - "wc"
      - "sort"

  filesystem:
    enabled: true
    allowedPaths:
      - "{{ openclaw_home }}/workspace"
      - "{{ openclaw_home }}/scripts"
      - "{{ openclaw_home }}/feature-tips-state"
{% if llm_provider == 'minimax' %}
      - "{{ openclaw_home }}/workspace-pincermove"
{% endif %}
{% if rp_telegram_bottoken | default('') | length > 0 %}
      - "{{ openclaw_home }}/workspace-rp"
      - "{{ openclaw_home }}/world-events"
{% endif %}
    deniedPaths:
      - "{{ openclaw_home }}/.ssh"
      - "{{ openclaw_home }}/.openclaw/credentials"
      - "/etc"
      - "/root"
      - "/var"
