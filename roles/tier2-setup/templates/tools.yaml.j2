# Generated by Ansible (Hardened Tier 2)
tools:
  shell:
    enabled: true
    allowlist:
      - "ls"
      - "cat"
      - "grep"
      - "head"
      - "tail"
      - "find"
      - "wc"
      - "sort"

  filesystem:
    enabled: true
    allowedPaths:
      - "{{ openclaw_home }}/workspace"
      - "{{ openclaw_home }}/clawd"
    deniedPaths:
      - "{{ openclaw_home }}/.ssh"
      - "{{ openclaw_home }}/.openclaw/credentials"
      - "/etc"
      - "/root"
      - "/var"
