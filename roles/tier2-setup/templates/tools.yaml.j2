# Generated by Ansible (Tier 2 minimal bootstrap, moderate security)
tools:
  shell:
    enabled: true
    allowlist:
      - "bash"
      - "ls"
      - "cat"
      - "grep"
      - "head"
      - "tail"
      - "find"
      - "wc"
      - "sort"
      - "git"
      - "openclaw"

  filesystem:
    enabled: true
    allowedPaths:
      - "{{ openclaw_home }}/workspace"
{% if legacy_scripts_enabled | default(false) | bool %}
      - "{{ openclaw_home }}/workspace/legacy-scripts"
{% endif %}
    deniedPaths:
      - "{{ openclaw_home }}/.ssh"
      - "{{ openclaw_home }}/.codex"
      - "{{ openclaw_home }}/.openclaw/credentials"
      - "/etc"
      - "/root"
      - "/var"
