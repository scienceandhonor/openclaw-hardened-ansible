# Generated by Ansible (Hardened Tier 2)
tools:
  shell:
    enabled: true
    allowlist:
      - "bash"
      - "ls"
      - "cat"
      - "grep"
      - "head"
      - "tail"
      - "find"
      - "wc"
      - "sort"
      - "git"

  filesystem:
    enabled: true
    allowedPaths:
      - "{{ openclaw_home }}/workspace"
      - "{{ openclaw_home }}/scripts"
      - "{{ openclaw_home }}/feature-tips-state"
      - "{{ openclaw_home }}/workspace-pincermove"
{% if obsidian_repo_slug | default('') | length > 0 %}
      - "{{ openclaw_home }}/obsidian-vault"
      - "{{ openclaw_home }}/obsidian-state"
{% endif %}
    deniedPaths:
      - "{{ openclaw_home }}/.ssh"
      - "{{ openclaw_home }}/.openclaw/credentials"
      - "/etc"
      - "/root"
      - "/var"
