{
  "version": 1,
  "defaults": {
    "security": "allowlist",
    "ask": "on-miss",
    "askFallback": "deny",
    "autoAllowSkills": false
  },
  "agents": {
    "main": {
      "security": "allowlist",
      "ask": "on-miss",
      "askFallback": "deny"
    },
    "pincermove": {
      "security": "allowlist",
      "ask": "on-miss",
      "askFallback": "deny",
      "allowlist": [
        { "pattern": "/usr/bin/bash" },
        { "pattern": "/bin/bash" },
        { "pattern": "/usr/bin/cat" },
        { "pattern": "/bin/cat" },
        { "pattern": "/usr/bin/grep" },
        { "pattern": "/bin/grep" },
        { "pattern": "/usr/bin/head" },
        { "pattern": "/usr/bin/tail" },
        { "pattern": "/usr/bin/find" },
        { "pattern": "/bin/find" },
        { "pattern": "/usr/bin/ls" },
        { "pattern": "/bin/ls" },
        { "pattern": "{{ openclaw_home }}/obsidian-vault/**" },
        { "pattern": "/usr/bin/wc" },
        { "pattern": "/usr/bin/sort" },
        { "pattern": "/usr/bin/python3" },
        { "pattern": "/usr/bin/git" },
        { "pattern": "{{ openclaw_bin.stdout }}" },
        { "pattern": "/usr/bin/date" },
        { "pattern": "/bin/date" },
        { "pattern": "{{ openclaw_home }}/scripts/run-substack-digest.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/run-reddit-digest.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/run-xurl-digest.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/fetch-reddit-posts.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/fetch-xurl-timeline.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/fetch-lastfm-artists.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/daily-stoic.py" },
        { "pattern": "{{ openclaw_home }}/scripts/daily-stoic.toml" },
        { "pattern": "{{ openclaw_home }}/scripts/check-bands.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/bandcheck-prompt.txt" },
        { "pattern": "{{ openclaw_home }}/scripts/openclaw-feature-tips-prompt.txt" },
        { "pattern": "{{ openclaw_home }}/scripts/openclaw-feature-tips-monday-reminder.txt" },
        { "pattern": "{{ openclaw_home }}/scripts/obsidian-summarize-prompt.txt" },
        { "pattern": "{{ openclaw_home }}/scripts/write-obsidian-summary.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/git-commit-obsidian.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/clear-obsidian-queue.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/write-band-verdicts.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/fetch-url-content.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/fetch-url-content.py" }
      ]
    }
  }
}
