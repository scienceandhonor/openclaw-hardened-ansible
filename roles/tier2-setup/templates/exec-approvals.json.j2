{
  "version": 1,
  "defaults": {
    "security": "allowlist",
    "ask": "on-miss",
    "askFallback": "deny",
    "autoAllowSkills": false
  },
  "agents": {
    "dev": {
      "security": "allowlist",
      "ask": "off",
      "allowlist": [
        { "pattern": "/usr/bin/bash" },
        { "pattern": "/bin/bash" },
        { "pattern": "{{ openclaw_home }}/scripts/check-bands.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/fetch-lastfm-artists.sh" },
        { "pattern": "/usr/bin/ls" },
        { "pattern": "/bin/ls" },
        { "pattern": "/usr/bin/cat" },
        { "pattern": "/bin/cat" },
        { "pattern": "/usr/bin/grep" },
        { "pattern": "/bin/grep" },
        { "pattern": "/usr/bin/head" },
        { "pattern": "/usr/bin/tail" },
        { "pattern": "/usr/bin/find" },
        { "pattern": "/usr/bin/wc" },
        { "pattern": "/usr/bin/sort" },
        { "pattern": "/usr/bin/python3" },
        { "pattern": "/usr/bin/git" },
        { "pattern": "{{ openclaw_bin.stdout }}" },
        { "pattern": "/usr/bin/date" },
        { "pattern": "/bin/date" }
      ]
    },
    "files": {
      "security": "deny",
      "ask": "always"
    },
    "pincermove": {
      "security": "allowlist",
      "ask": "off",
      "allowlist": [
        { "pattern": "{{ openclaw_home }}/scripts/run-substack-digest.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/run-reddit-digest.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/run-xurl-digest.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/run-substack-check.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/fetch-reddit-posts.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/fetch-xurl-timeline.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/fetch-lastfm-artists.sh" },
        { "pattern": "{{ openclaw_home }}/scripts/daily-stoic.py" },
        { "pattern": "{{ openclaw_home }}/scripts/daily-stoic.toml" },
        { "pattern": "/usr/bin/bash" },
        { "pattern": "/bin/bash" },
        { "pattern": "/usr/bin/python3" },
        { "pattern": "/usr/bin/git" },
        { "pattern": "{{ openclaw_bin.stdout }}" }
      ]
    }
  }
}
