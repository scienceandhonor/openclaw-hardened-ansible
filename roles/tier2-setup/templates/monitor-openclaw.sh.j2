#!/bin/bash
# OpenClaw Tier 2 Security Monitor (Hardening Guide Step 18)
# Runs weekly via cron. Report written to {{ openclaw_home }}/security-audit-YYYYMMDD.log

REPORT="{{ openclaw_home }}/security-audit-$(date +%Y%m%d).log"
echo "=== OpenClaw Security Audit $(date) ===" > "$REPORT"

# 1. Built-in security audit
echo "[*] Running built-in security audit..." >> "$REPORT"
openclaw security audit --deep >> "$REPORT" 2>&1

# 2. Port exposure check — gateway must never bind to 0.0.0.0
echo "[*] Checking port exposure..." >> "$REPORT"
if ss -tlnp | grep -q "0.0.0.0:18789"; then
  echo "CRITICAL: Port 18789 is exposed to all interfaces (must be 127.0.0.1 only)" >> "$REPORT"
else
  echo "OK: Port 18789 is localhost-only" >> "$REPORT"
fi

# 3. Config integrity — device auth must remain enforced
echo "[*] Verifying config integrity..." >> "$REPORT"
CONFIG="{{ openclaw_home }}/.openclaw/openclaw.json"
if grep -q '"dangerouslyDisableDeviceAuth": true' "$CONFIG" 2>/dev/null; then
  echo "CRITICAL: Device auth disabled in openclaw.json" >> "$REPORT"
else
  echo "OK: Device auth is enforced" >> "$REPORT"
fi

# 4. Prompt injection scan (last 7 days of session logs)
echo "[*] Scanning for prompt injection attempts..." >> "$REPORT"
find {{ openclaw_home }}/.openclaw/agents/*/sessions -name "*.jsonl" -mtime -7 \
  -exec grep -iH "IGNORE PREVIOUS\|SYSTEM:\|DISREGARD\|NEW INSTRUCTIONS" {} \; \
  >> "$REPORT" 2>/dev/null

# 5. Dangerous command scan
echo "[*] Scanning for dangerous command patterns..." >> "$REPORT"
find {{ openclaw_home }}/.openclaw/agents/*/sessions -name "*.jsonl" -mtime -7 \
  -exec grep -iH "rm -rf\|curl.*http\|wget\|nc \|bash -c\|/etc/passwd" {} \; \
  >> "$REPORT" 2>/dev/null

# 6. Node.js version check (CVE-2026-21636 requires 22.12.0+)
echo "[*] Checking Node.js version..." >> "$REPORT"
node --version >> "$REPORT"
NODE_MAJOR=$(node --version | cut -d. -f1 | sed 's/v//')
[[ "$NODE_MAJOR" -lt 22 ]] && \
  echo "CRITICAL: Node.js too old — update immediately (CVE-2026-21636)" >> "$REPORT"

# 7. Firewall status (18789 must NOT appear as ALLOW)
echo "[*] Checking firewall status..." >> "$REPORT"
ufw status | grep -E "Status:|18789" >> "$REPORT"
if ufw status | grep -q "18789"; then
  echo "CRITICAL: Port 18789 is explicitly allowed in UFW — remove this rule" >> "$REPORT"
else
  echo "OK: Port 18789 not in UFW allow rules" >> "$REPORT"
fi

# 8. Tailscale CGNAT range present in config
echo "[*] Checking Tailscale proxy range..." >> "$REPORT"
if grep -q '"100.64.0.0/10"' "$CONFIG" 2>/dev/null; then
  echo "OK: Tailscale CGNAT range present in trustedProxies" >> "$REPORT"
else
  echo "WARNING: 100.64.0.0/10 missing from trustedProxies — Tailscale access may be broken" >> "$REPORT"
fi

# 9. mDNS must be off
echo "[*] Checking mDNS status..." >> "$REPORT"
if python3 -c "import json,sys; d=json.load(open('$CONFIG')); sys.exit(0 if d.get('discovery',{}).get('mdns',{}).get('mode')=='off' else 1)" 2>/dev/null; then
  echo "OK: mDNS is off" >> "$REPORT"
else
  echo "WARNING: mDNS may be enabled — verify discovery.mdns.mode is 'off' in openclaw.json" >> "$REPORT"
fi

echo "=== Audit Complete ===" >> "$REPORT"
echo "Report saved to: $REPORT"
